# Copy to .env and adjust. .env / .env.dev / .env.test / .env.prod are gitignored.
# VITE_BASE_URL is the BACKEND: Django's urls.py mounts everything under /api,
# and src/api/endpoints appends v1/... to this, so it must end at /api with no
# trailing slash.
VITE_BASE_URL=http://localhost:8000/api
VITE_FRONTEND_URL=http://localhost:3000
VITE_MODE=dev
