  "metricDefinitions": [
    {
      "key": "totalUsers",
      "label": "Total registered",
      "unit": "unique users",
      "formula": "Distinct platform_user rows retained as of the period end.",
      "caution": "Includes users with no term, members and past members. Excludes deactivated accounts from the ACTIVE base but never from history."
    },
    {
      "key": "newRegistrations",
      "label": "New registrations",
      "unit": "unique users",
      "formula": "Distinct users whose registered_at falls in the period.",
      "caution": "Failed and partial registrations are excluded at intake, not here."
    },
    {
      "key": "profileCompletion",
      "label": "Profile completion",
      "unit": "unique users",
      "formula": "Users meeting the configured completion threshold for profile v1.",
      "caution": "Re-graded when the profile schema versions. Old rows keep the version they were graded against."
    },
    {
      "key": "engagement",
      "label": "Active users / MAU",
      "unit": "unique users",
      "formula": "Distinct users with at least one qualifying platform event in the window.",
      "caution": "UNAVAILABLE until UM-OD-10 defines the qualifying-event taxonomy. Shown as unavailable, never as zero."
    },
    {
      "key": "deactivatedAccounts",
      "label": "Deactivated accounts",
      "unit": "unique users",
      "formula": "Distinct users whose user_status is deactivated as of the period end.",
      "caution": "An account status, not a commercial one. A deactivated account may still have a live subscription in Finance, and cancelling one is a separate, deliberate act."
    }
  ],
