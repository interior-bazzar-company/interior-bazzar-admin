{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    /* src/content/**.json — the prototype stand-in for endpoints that do not
       exist yet (see src/proto/v-2.2.0.0). Vite already bundles JSON imports;
       this only tells tsc the same thing. */
    "resolveJsonModule": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* `@/` — the import root the Untitled UI components are written against.
       Mirrored in vite.config.ts and the root tsconfig.json (the esbuild
       smoke bundles read that one). */
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src"]
}
