{
  "name": "interiorbazzaradminfrontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build:dev": "vite build --mode dev",
    "start:dev": "vite --mode dev --host",
    "build:test": "vite build --mode test",
    "start:test": "vite --mode test --host",
    "start:prod": "vite --mode prod --host",
    "build": "tsc -b && vite build --mode prod",
    "lint": "eslint .",
    "check:enquiries": "node scripts/check-enquiry-seed.cjs",
    "check:export": "esbuild src/admin/views/BusinessEnquiries/exportCsv.ts --bundle --platform=node --format=cjs --define:import.meta.env={} --log-level=error --outfile=node_modules/.tmp/enquiry-export.cjs && node scripts/check-enquiry-export.cjs",
    "check:clock": "esbuild src/admin/views/BusinessEnquiries/store.ts --bundle --platform=node --format=cjs --define:import.meta.env={} --external:react --log-level=error --outfile=node_modules/.tmp/enquiry-store.cjs && node scripts/check-enquiry-clock.cjs",
    "check:share": "node scripts/check-enquiry-share.cjs",
    "check:wiring": "esbuild src/admin/views/BusinessEnquiries/store.ts --bundle --platform=node --format=cjs --define:import.meta.env={} --external:react --log-level=error --outfile=node_modules/.tmp/enquiry-store.cjs && node scripts/check-enquiry-wiring.cjs",
    "check:match": "esbuild src/admin/views/BusinessEnquiries/store.ts --bundle --platform=node --format=cjs --define:import.meta.env={} --external:react --log-level=error --outfile=node_modules/.tmp/enquiry-store.cjs && node scripts/check-enquiry-match.cjs",
    "check:users": "esbuild src/admin/views/Users/store.ts --bundle --platform=node --format=cjs --define:import.meta.env={} --external:react --log-level=error --outfile=node_modules/.tmp/users-store.cjs && node scripts/check-users-derivation.cjs",
    "check:users-render": "node scripts/build-um-smoke.cjs && node node_modules/.tmp/um-smoke.cjs",
    "check": "npm run check:enquiries && npm run check:export && npm run check:clock && npm run check:share && npm run check:wiring && npm run check:match && npm run check:users && npm run check:users-render && npm run check:finance-nav && npm run check:finance && npm run check:finance-render && npm run check:popovers && npm run check:team && npm run check:team-nav && npm run check:team-render && npm run check:overview && npm run check:overview-nav && npm run check:resources && npm run check:resources-render && npm run check:agreements && npm run check:agreements-render && npm run check:tokens && npm run check:contrast && npm run check:dupes",
    "preview": "vite preview",
    "check:finance": "esbuild scripts/finance-check-entry.ts --bundle --platform=node --format=cjs --define:import.meta.env={} --external:react --log-level=error --outfile=node_modules/.tmp/finance-store.cjs && node scripts/check-finance-ledger.cjs",
    "check:finance-render": "node scripts/build-fn-smoke.cjs && node node_modules/.tmp/fn-smoke.cjs",
    "check:finance-nav": "node scripts/check-finance-nav.cjs",
    "check:popovers": "node scripts/check-popover-triggers.cjs",
    "check:browser": "node scripts/check-browser.cjs",
    "check:team": "node scripts/check-team-derivation.cjs",
    "check:team-nav": "node scripts/check-team-nav.cjs",
    "check:overview": "node scripts/check-overview.cjs",
    "check:overview-nav": "node scripts/check-overview-nav.cjs",
    "check:team-render": "node scripts/build-tm-smoke.cjs && node node_modules/.tmp/tm-smoke.cjs",
    "check:resources": "node scripts/check-resources.cjs",
    "check:resources-render": "node scripts/build-rs-smoke.cjs && node node_modules/.tmp/rs-smoke.cjs",
    "check:agreements": "node scripts/check-agreements.cjs",
    "check:agreements-render": "node scripts/build-ag-smoke.cjs && node node_modules/.tmp/ag-smoke.cjs",
    "check:tokens": "node scripts/check-tokens.cjs",
    "check:contrast": "node design/ramp.cjs",
    "shots": "node scripts/shoot-appearance.cjs",
    "check:menu": "node scripts/check-appearance-menu.cjs",
    "check:dupes": "node scripts/check-dupes.cjs"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.8.2",
    "lottie-web": "^5.13.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^25.9.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "playwright": "^1.56.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2"
  }
}
